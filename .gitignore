# ---------------------------------------------------------------
# MATLAB
# ---------------------------------------------------------------

# Autosave files (Windows: .asv, Linux/macOS: .m~)
*.asv
*.m~

# Compiled MEX binaries (all platforms)
*.mex*

# Packaged app and toolbox files
*.mlappinstall
*.mltbx

# Generated helpsearch folders
helpsearch*/

# Code generation folders
codegen/
slprj/
sccprj/

# Simulink autosave and cache files
*.autosave
*.slxc

# Octave session info
octave-workspace

# ---------------------------------------------------------------
# Python (the JSON files in examples/json are used by the python
# implementation; notebooks are kept in resource-data)
# ---------------------------------------------------------------
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/

# ---------------------------------------------------------------
# Graphics
# Result graphics are stored as PDF only; EPS files written by
# mb_graphics (or LaTeX "-eps-converted-to.pdf" files) are not tracked
# ---------------------------------------------------------------
*.eps
*-eps-converted-to.pdf

# ---------------------------------------------------------------
# Editors, IDEs, operating systems
# ---------------------------------------------------------------
.idea/
.vscode/
*~
\#*\#
.#*
*.swp
.DS_Store
Thumbs.db
desktop.ini

# LibreOffice lock files
.~lock.*#
